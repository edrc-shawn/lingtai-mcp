# ═══════════════════════════════════════════
# 灵台 MCP Server — 环境变量配置
# ═══════════════════════════════════════════
# 复制此文件为 .env 并填入你的密钥：
#   cp .env.example .env
# 请勿将 .env 提交到 Git（已在 .gitignore 中排除）

# Obsidian 知识库路径（可选，默认自动检测）
LINGTAI_VAULT=C:\path\to\your\vault

# 客户端标识（可选，用于多端区分）
LINGTAI_CLIENT_ID=claude-desktop

# ═══════════════════════════════════════════
# 搜索服务 API 密钥
# ═══════════════════════════════════════════

# Tavily 搜索（优先使用，需申请 API Key）
# 注册: https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# AnySearch 搜索（Tavily 降级方案，1000 次/天免费）
# 注册: https://anysearch.com
ANYSEARCH_API_KEY=as_sk_your-key-here

# ═══════════════════════════════════════════
# LLM 推理引擎配置
# ═══════════════════════════════════════════

# DeepSeek / SiliconFlow / 其他兼容 API
# 若通过 config.py 的 api_keys.json 配置则无需重复设置
DEEPSEEK_API_KEY=sk-your-key-here
SILICONFLOW_API_KEY=sk-your-key-here

# ═══════════════════════════════════════════
# GitHub / Gitee 集成
# ═══════════════════════════════════════════
GITHUB_TOKEN=ghp_your-token-here
GITEE_TOKEN=your-gitee-token-here